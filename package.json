{
  "name": "postman-openapi-drift-companion",
  "displayName": "Postman OpenAPI Drift Companion",
  "description": "Warns on a Postman collection endpoint whose method+path no longer exists in the project's OpenAPI/Swagger spec. No data leaves your editor.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "postman",    "openapi",    "swagger",    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-postman-openapi-drift-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-postman-openapi-drift-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
